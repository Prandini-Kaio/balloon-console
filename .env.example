VITE_API_BASE_URL=/api/v1
VITE_COMPANIES_USE_HTTP=false

# Domínio próprio (console.balloon.app.br): use /
# Path do GitHub Pages sem domínio: /balloon-console/
# VITE_BASE=/

# Ambientes:
# - dev:local  (.env.localdev) -> proxy para http://localhost:8080
# - dev:prod   (.env.proddev)  -> proxy para https://api.balloon.app.br
# - build:prod (.env.prod)     -> https://api.balloon.app.br/api/v1
#
# Produção (API) com domínio próprio:
# BALLOON_CORS_ALLOWED_ORIGINS=https://console.balloon.app.br
